  "data_quality": [
    {
      "code": "DQ01",
      "severity": "high",
      "check": "Deal records cover the whole lead period",
      "affected": 2002,
      "share": 0.25025,
      "finding": "The first recorded deal is dated 05 Dec 2017, but leads start 14 Jun 2017. Leads first contacted before 2018 show 3.0% conversion against 13.0% after.",
      "impact": "Conversion for 2017 leads looks far lower than it was, which would distort any trend or channel comparison that includes them.",
      "recommendation": "Analyse only leads from January 2018, and confirm with the CRM owner when deal logging began."
    },
    {
      "code": "DQ02",
      "severity": "high",
      "check": "Every lead has a recorded source",
      "affected": 1159,
      "share": 0.144875,
      "finding": "60 leads have a blank origin and 1,099 are marked 'unknown'. In the 2018 cohort these unattributed leads convert at 19.6% within 90 days, against 9.9% for attributed leads.",
      "impact": "The best-converting group has no source, so marketing spend cannot be tied to the leads that matter most.",
      "recommendation": "Make source a required field on the enquiry form and CRM, and audit how 'unknown' leads are created (for example manual or phone entries)."
    },
    {
      "code": "DQ03",
      "severity": "high",
      "check": "Sales rep is recorded on every lead",
      "affected": 7158,
      "share": 0.89475,
      "finding": "SDR and sales rep IDs exist only on won deals; lost leads carry no rep.",
      "impact": "Rep conversion rates cannot be measured, only rep deal counts, which reward volume rather than skill.",
      "recommendation": "Record the assigned rep when a lead is first contacted, not when it is won."
    },
    {
      "code": "DQ04",
      "severity": "low",
      "check": "Won date is on or after first contact",
      "affected": 1,
      "share": 0.0011876485,
      "finding": "1 deal(s) are dated before the lead's first contact.",
      "impact": "Minor: these are treated as same-day wins and flagged.",
      "recommendation": "Check whether first contact is logged late for some leads."
    },
    {
      "code": "DQ05",
      "severity": "medium",
      "check": "Declared monthly revenue is usable",
      "affected": 797,
      "share": 0.9465558195,
      "finding": "797 of 842 deals (95%) record declared revenue as 0, which looks like 'not asked' rather than true zero; 2 record 1,000,000 or more (maximum 50,000,000).",
      "impact": "Deal value cannot be estimated from this field, so revenue analysis must use actual orders instead.",
      "recommendation": "Store 'not provided' as blank, not 0, and add a sense check on very large values."
    },
    {
      "code": "DQ06",
      "severity": "medium",
      "check": "Deal profile fields are filled in",
      "affected": 756,
      "share": 0.9222090261,
      "finding": "Missing share: has_company 93%, has_gtin 92%, average_stock 92%, declared_product_catalog_size 92%.",
      "impact": "These fields cannot support segmentation or scoring.",
      "recommendation": "Either make them part of the closing checklist or drop them from the form."
    },
    {
      "code": "DQ07",
      "severity": "low",
      "check": "Behaviour profile has one clean value",
      "affected": 193,
      "share": 0.229216152,
      "finding": "177 deals have no profile and 16 hold two values (for example 'cat, wolf').",
      "impact": "Profile-based reporting needs a rule for blanks and multiple values.",
      "recommendation": "Use a single-select field with an explicit 'not assessed' option."
    },
    {
      "code": "DQ08",
      "severity": "medium",
      "check": "Won sellers appear in order data",
      "affected": 463,
      "share": 0.5498812352,
      "finding": "463 of 842 won sellers have no order in the public order data.",
      "impact": "The public order file may not hold every order, so seller activation measured here is a lower bound.",
      "recommendation": "Use the full order table when this analysis runs on internal data."
    },
